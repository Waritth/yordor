{
  "name": "yordor",
  "private": true,
  "version": "0.1.0",
  "description": "YorDor — golf betting score app (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "db:migrate": "npm run db:migrate --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:dev": "docker start yordor-dev-db || docker run -d --name yordor-dev-db --restart unless-stopped -e POSTGRES_PASSWORD=yordor_dev -e POSTGRES_DB=yordor -p 5433:5432 -v yordor-dev-pg:/var/lib/postgresql/data postgres:16-alpine"
  },
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=20"
  }
}
